{
    "files.associations": {
        "*.session": "sdns",
        "*.keys": "sdns"
    },
    // ========================================
    // PERFORMANCE OPTIMIZATIONS
    // ========================================
    "files.watcherExclude": {
        "**/node_modules/**": true,
        "**/src-tauri/target/**": true,
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/portal/node_modules/**": true,
        "**/*.vsix": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/src-tauri/target": true,
        "**/portal/node_modules": true,
        "**/*.vsix": true,
        "**/out/**": true
    },
    "files.exclude": {
        "**/.git": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true
    }
    // NOTE: Syntax highlighting for SDNS files is provided by the
    // SDNS Language Extension at src/sdns/vscode-extension/
    // Install with: cd src/sdns/vscode-extension && npm run package
}