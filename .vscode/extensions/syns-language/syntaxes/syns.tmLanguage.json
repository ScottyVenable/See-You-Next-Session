{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "SYNS Dialogue",
    "scopeName": "source.syns",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#blocks"
        },
        {
            "include": "#directives"
        },
        {
            "include": "#speakers"
        },
        {
            "include": "#goto"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#metadata"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#variables"
        },
        {
            "include": "#functions"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.syns",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.syns",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "blocks": {
            "patterns": [
                {
                    "name": "entity.name.section.syns",
                    "match": "^\\s*(===)\\s*(@?[\\w:.\\-]+)\\s*(===)",
                    "captures": {
                        "1": {
                            "name": "punctuation.definition.section.begin.syns"
                        },
                        "2": {
                            "name": "entity.name.function.syns"
                        },
                        "3": {
                            "name": "punctuation.definition.section.end.syns"
                        }
                    }
                }
            ]
        },
        "directives": {
            "patterns": [
                {
                    "name": "keyword.control.conditional.syns",
                    "match": "@(if|elseif|else|endif)\\b"
                },
                {
                    "name": "keyword.control.flow.syns",
                    "match": "@(when|end|trigger)\\b"
                },
                {
                    "name": "keyword.other.action.syns",
                    "match": "@(reveal|unlock|set)\\b"
                },
                {
                    "name": "keyword.other.rapport.syns",
                    "match": "@rapport\\b",
                    "captures": {
                        "0": {
                            "name": "support.function.rapport.syns"
                        }
                    }
                },
                {
                    "name": "keyword.other.focus.syns",
                    "match": "@focus\\b",
                    "captures": {
                        "0": {
                            "name": "support.function.focus.syns"
                        }
                    }
                },
                {
                    "name": "keyword.other.pause.syns",
                    "match": "@pause\\b"
                }
            ]
        },
        "speakers": {
            "patterns": [
                {
                    "name": "entity.name.type.speaker.patient.syns",
                    "match": "^\\s*(PATIENT)\\s*",
                    "captures": {
                        "1": {
                            "name": "entity.name.type.class.syns"
                        }
                    }
                },
                {
                    "name": "entity.name.type.speaker.therapist.syns",
                    "match": "^\\s*(THERAPIST)\\s*",
                    "captures": {
                        "1": {
                            "name": "entity.name.type.interface.syns"
                        }
                    }
                },
                {
                    "name": "entity.name.type.speaker.narrator.syns",
                    "match": "^\\s*(NARRATOR)\\s*",
                    "captures": {
                        "1": {
                            "name": "entity.name.type.namespace.syns"
                        }
                    }
                },
                {
                    "name": "entity.name.type.speaker.system.syns",
                    "match": "^\\s*(SYSTEM)\\s*",
                    "captures": {
                        "1": {
                            "name": "entity.name.type.enum.syns"
                        }
                    }
                },
                {
                    "name": "variable.parameter.mood.syns",
                    "match": "\\((nervous|anxious|defensive|relieved|sad|angry|hopeful|stressed|vulnerable|thoughtful|hesitant|guarded|dismissive|surprised|embarrassed|frustrated|deflecting)\\)",
                    "captures": {
                        "1": {
                            "name": "support.constant.mood.syns"
                        }
                    }
                }
            ]
        },
        "goto": {
            "patterns": [
                {
                    "name": "keyword.control.goto.syns",
                    "match": "(->)\\s*([\\w_-]+)",
                    "captures": {
                        "1": {
                            "name": "punctuation.definition.arrow.syns"
                        },
                        "2": {
                            "name": "entity.name.tag.target.syns"
                        }
                    }
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.syns",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "include": "#keywords"
                        },
                        {
                            "include": "#metadata"
                        },
                        {
                            "name": "constant.character.escape.syns",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.action.syns",
                    "begin": "\\*",
                    "end": "\\*",
                    "patterns": [
                        {
                            "name": "constant.character.escape.syns",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "markup.bold.keyword.syns",
                    "match": "\\[([^\\]]+)\\]",
                    "captures": {
                        "0": {
                            "name": "entity.other.attribute-name.syns"
                        },
                        "1": {
                            "name": "string.interpolated.keyword.syns"
                        }
                    }
                }
            ]
        },
        "metadata": {
            "patterns": [
                {
                    "name": "meta.tag.metadata.syns",
                    "match": "<(contradicts|reveals):([^>]+)>",
                    "captures": {
                        "1": {
                            "name": "support.type.property-name.syns"
                        },
                        "2": {
                            "name": "variable.other.property.syns"
                        }
                    }
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.comparison.syns",
                    "match": "(>=|<=|==|!=|>|<)"
                },
                {
                    "name": "keyword.operator.logical.syns",
                    "match": "(&&|\\|\\||!)"
                },
                {
                    "name": "keyword.operator.arithmetic.syns",
                    "match": "(\\+|-)"
                },
                {
                    "name": "keyword.operator.assignment.syns",
                    "match": "="
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.syns",
                    "match": "\\b[+-]?\\d+(\\.\\d+)?\\b"
                }
            ]
        },
        "variables": {
            "patterns": [
                {
                    "name": "variable.other.dollar.syns",
                    "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
                },
                {
                    "name": "variable.language.builtin.syns",
                    "match": "\\b(rapport|focus|turn|breakthroughs)\\b"
                },
                {
                    "name": "constant.language.boolean.syns",
                    "match": "\\b(true|false)\\b"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "support.function.builtin.syns",
                    "match": "\\b(has_symptom|has_keyword|has_breakthrough|asked_about)\\s*\\(",
                    "captures": {
                        "1": {
                            "name": "entity.name.function.syns"
                        }
                    }
                }
            ]
        }
    }
}