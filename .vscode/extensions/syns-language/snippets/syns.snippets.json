{
    "Block Section": {
        "prefix": "block",
        "body": [
            "=== ${1:block-name} ===",
            "${0}",
            ""
        ],
        "description": "Create a new dialogue block"
    },
    "Response Handler": {
        "prefix": "response",
        "body": [
            "=== @response:${1:keyword} ===",
            "PATIENT (${2:mood})",
            "\"${3:dialogue}\"",
            "",
            "@rapport ${4:+5}",
            "-> ${5:next-block}",
            ""
        ],
        "description": "Create a response handler block"
    },
    "Conditional Response": {
        "prefix": "ifrapport",
        "body": [
            "@if rapport ${1:>=} ${2:70}",
            "PATIENT (${3:mood})",
            "\"${4:high rapport response}\"",
            "@else",
            "PATIENT (${5:mood})",
            "\"${6:low rapport response}\"",
            "@endif",
            ""
        ],
        "description": "Conditional dialogue based on rapport"
    },
    "Patient Line": {
        "prefix": "patient",
        "body": [
            "PATIENT (${1|nervous,anxious,defensive,relieved,sad,hopeful,stressed,vulnerable,thoughtful,hesitant,guarded|})",
            "\"${2:dialogue}\""
        ],
        "description": "Patient dialogue line with mood"
    },
    "Therapist Line": {
        "prefix": "therapist",
        "body": [
            "THERAPIST",
            "\"${1:dialogue}\""
        ],
        "description": "Therapist dialogue line"
    },
    "Narrator Line": {
        "prefix": "narrator",
        "body": [
            "NARRATOR",
            "*${1:description}*"
        ],
        "description": "Narrator description"
    },
    "Reveal Action": {
        "prefix": "reveal",
        "body": [
            "@reveal ${1:symptom-id}"
        ],
        "description": "Reveal a symptom or insight"
    },
    "Unlock Action": {
        "prefix": "unlock",
        "body": [
            "@unlock ${1:topic-id}"
        ],
        "description": "Unlock a new topic"
    },
    "Rapport Change": {
        "prefix": "rapport",
        "body": [
            "@rapport ${1|+5,+8,+10,-3,-5,-8|}"
        ],
        "description": "Change rapport value"
    },
    "Focus Change": {
        "prefix": "focus",
        "body": [
            "@focus ${1|+10,+15,-10,-15|}"
        ],
        "description": "Change focus value"
    },
    "Goto": {
        "prefix": "goto",
        "body": [
            "-> ${1:target-block}"
        ],
        "description": "Go to another block"
    },
    "If Block": {
        "prefix": "if",
        "body": [
            "@if ${1:condition}",
            "${0}",
            "@endif"
        ],
        "description": "Conditional block"
    },
    "If-Else Block": {
        "prefix": "ifelse",
        "body": [
            "@if ${1:condition}",
            "${2}",
            "@else",
            "${0}",
            "@endif"
        ],
        "description": "Conditional block with else"
    },
    "When Trigger": {
        "prefix": "when",
        "body": [
            "@when ${1|symptom_revealed,keyword_used,breakthrough|}:${2:id}",
            "${0}",
            "@end"
        ],
        "description": "Trigger block for events"
    },
    "Has Symptom Check": {
        "prefix": "hassymptom",
        "body": [
            "has_symptom(\"${1:symptom-id}\")"
        ],
        "description": "Check if symptom is revealed"
    },
    "Has Keyword Check": {
        "prefix": "haskeyword",
        "body": [
            "has_keyword(\"${1:keyword}\")"
        ],
        "description": "Check if keyword was used"
    },
    "Breakthrough Block": {
        "prefix": "breakthrough",
        "body": [
            "=== @breakthrough:${1:topic} ===",
            "NARRATOR",
            "*A breakthrough moment.*",
            "",
            "PATIENT (${2:vulnerable})",
            "\"${3:meaningful confession or realization}\"",
            "",
            "@reveal ${4:symptom-id}",
            "@rapport +10",
            "-> ${5:next-block}",
            ""
        ],
        "description": "Create a breakthrough moment"
    },
    "Full Dialogue Template": {
        "prefix": "dialoguefile",
        "body": [
            "// ${1:Character} - Turn ${2:1} Dialogue",
            "// ${3:Description of this dialogue file}",
            "",
            "=== intro ===",
            "PATIENT (${4:nervous})",
            "\"${5:Opening line}\"",
            "",
            "-> ${6:main}",
            "",
            "=== ${6:main} ===",
            "PATIENT (${7:mood})",
            "\"${8:Main dialogue}\"",
            "",
            "@if rapport >= 60",
            "PATIENT (${9:mood})",
            "\"${10:Additional line if rapport is good}\"",
            "@endif",
            "",
            "-> end",
            "",
            "=== end ===",
            "NARRATOR",
            "*The conversation concludes.*",
            ""
        ],
        "description": "Full dialogue file template"
    }
}