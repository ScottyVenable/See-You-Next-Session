# Portal Environment Variables
# Copy this file to .env and fill in your values

# GitHub Repository (auto-populated by GitHub Actions)
VITE_REPO_OWNER=ScottyVenable
VITE_REPO_NAME=See-You-Next-Session

# Portal Auth (set DEV_PASSWORD_HASH in GitHub Secrets)
VITE_DEV_PASSWORD_HASH=

# Firebase Configuration
# Get these from your Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
