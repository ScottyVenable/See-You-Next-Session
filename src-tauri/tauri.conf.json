{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "See You Next Session",
  "version": "0.2.0",
  "identifier": "com.seeyounextsession.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3001",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "See You Next Session",
        "width": 1280,
        "height": 720,
        "minWidth": 1024,
        "minHeight": 576,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game",
    "shortDescription": "A narrative puzzle game about mental health diagnosis",
    "longDescription": "See You Next Session is a narrative simulation/puzzle game where you play as a mental health professional diagnosing patients by identifying contradictions between dialogue and physical presentation.",
    "windows": {
      "wix": null,
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.13"
    }
  }
}