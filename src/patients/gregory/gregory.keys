===ACTIONS===

// Actions that can be triggered from keywords or dialogue

@askAbout.therapy.delay {
    label: "Ask About Waiting"
    description: "Ask Gregory why he waited so long to seek help"
    
    dialogueOptions: [
        {
            text: "What made you decide to finally come in?"
            response: "I guess... things just got bad enough that I couldn't ignore it anymore. My partner kept saying I should talk to someone."
            mood: "hesitant"
            effects: {
                rapportChange: 2
                focusCost: 5
            }
        }
        {
            text: "You mentioned months. What's been stopping you from seeking help sooner?"
            response: "I don't know. Part of me kept thinking I could handle it on my own. That maybe I was just... being dramatic."
            mood: "vulnerable"
            effects: {
                rapportChange: 3
                focusCost: 5
                reveals: ["self-reliance-issue"]
            }
        }
    ]
}

@askAbout.sleep {
    label: "Ask About Sleep"
    description: "Follow up on Gregory's sleep issues"
    
    dialogueOptions: [
        {
            text: "Tell me more about what happens when you try to sleep."
            response: "I just... lie there. My mind starts going over everything. Things I said, things I should have said. It's like a loop I can't stop."
            mood: "exhausted"
            effects: {
                rapportChange: 2
                focusCost: 5
                reveals: ["rumination-pattern"]
            }
        }
        {
            text: "When you say your mind won't shut off, what kinds of thoughts come up?"
            response: "Work stuff, mostly. Did I send that email right? Did I come across wrong in that meeting? Sometimes I'll check my phone at 3am just to make sure."
            mood: "anxious"
            effects: {
                rapportChange: 2
                focusCost: 5
                reveals: ["work-anxiety", "checking-behavior"]
            }
        }
    ]
}

@explore.childhood {
    label: "Explore Childhood"
    description: "Explore Gregory's childhood experiences"
    
    dialogueOptions: [
        {
            text: "What was it like growing up in your family?"
            response: "Normal, I guess? My parents worked a lot. They had high expectations. Good grades, good behavior. You know how it is."
            mood: "guarded"
            effects: {
                rapportChange: 1
                focusCost: 5
            }
        }
        {
            text: "You mentioned your feelings didn't matter. Can you tell me more about that?"
            response: "*long pause* I... I learned pretty early that crying or getting upset just made things worse. My dad would get frustrated. 'What do you have to cry about?' So I just... stopped."
            mood: "vulnerable"
            effects: {
                rapportChange: 5
                focusCost: 8
                reveals: ["emotional-suppression", "parental-invalidation"]
                triggers: ["breakthrough-childhood"]
            }
        }
    ]
}

===ANIMATIONS===

// Text animations that can be applied to words in dialogue
// Usage in .session files: [word]<anim:shake>

@shake {
    type: "shake"
    duration: 500
    intensity: 3
    easing: "ease-in-out"
    description: "Subtle shake for emphasis or distress"
}

@pulse {
    type: "pulse"
    duration: 1000
    scale: 1.1
    easing: "ease-in-out"
    description: "Gentle pulse for important revelations"
}

@glow {
    type: "glow"
    duration: 800
    color: "#f39c12"
    intensity: 0.5
    easing: "ease-out"
    description: "Soft glow for breakthroughs"
}

@fade {
    type: "fade"
    duration: 600
    direction: "in"
    easing: "ease-in"
    description: "Fade in effect for gradual reveals"
}

@highlight {
    type: "highlight"
    duration: 400
    color: "#fff3cd"
    easing: "ease-out"
    description: "Quick highlight flash for attention"
}

@wiggle {
    type: "wiggle"
    duration: 300
    intensity: 2
    easing: "linear"
    description: "Small wiggle for nervous or uncertain words"
}
