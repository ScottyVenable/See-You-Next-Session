                    "for months",
                    "several months",
                    "a few months",
                    "months now"
                ],
                "description": "A duration spanning multiple months - indicates a persistent issue",
                "importance": "medium",
                "style": {
                    "color": "#6b7fd7",
                    "bgColor": "rgba(107, 127, 215, 0.15)",
                    "icon": "calendar"
