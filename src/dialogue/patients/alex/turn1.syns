@if rapport >= 75
    PATIENT (vulnerable)
    "The future [scares me]. Honestly."
    
    @pause 1
    
    PATIENT (anxious)
    "I can't stop thinking about everything that could go wrong."
    
    PATIENT
    "What if I can't handle it? What if I fail?"
    
    PATIENT (stressed)
    "What if this feeling [never goes away]?"
    
    @pause 0.5
    
    PATIENT (sad)
    "What if I'm like this forever?"
    
    @rapport +10
    @reveal future-anxiety
    
@elseif rapport >= 55
    PATIENT (hesitant)
