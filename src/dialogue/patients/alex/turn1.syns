    PATIENT (deflecting)
    "That's what people say, anyway."
    
@else
    PATIENT (guarded)
    "The future will be fine."
    
    PATIENT
    "I don't want to jinx it by talking about it."
    
    @rapport -2
@endif

=== @response:self.strengths ===
@if rapport >= 60
    PATIENT (surprised)
    "Strengths? I... hm."
    
    @pause 1.5
    
    PATIENT (thoughtful)
    "I guess I'm [good at my job]. When I'm not panicking about it."
    
    PATIENT
    "I'm reliable. I always come through on my commitments."
    
    @pause 0.5
    
    @if rapport >= 75
        PATIENT (sad)
        "Even if it [destroys me] in the process."
        
        PATIENT (vulnerable)
        "Maybe that's not a strength. Maybe that's the problem."
        
        @rapport +8
        @reveal self-awareness
    @endif
@else
