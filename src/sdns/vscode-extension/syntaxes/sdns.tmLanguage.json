{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "SDNS",
    "scopeName": "source.sdns",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#blocks"
        },
        {
            "include": "#speakers"
        },
        {
            "include": "#directives"
        },
        {
            "include": "#goto"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#actions"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#observations"
        },
        {
            "include": "#conditions"
        },
        {
            "include": "#numbers"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.sdns",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.sdns",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "blocks": {
            "patterns": [
                {
                    "name": "entity.name.section.sdns",
                    "match": "^\\s*(===)\\s*(@?[\\w\\.:_-]+)\\s*(===)\\s*$",
                    "captures": {
                        "1": {
                            "name": "punctuation.definition.section.begin.sdns"
                        },
                        "2": {
                            "name": "entity.name.section.sdns"
                        },
                        "3": {
                            "name": "punctuation.definition.section.end.sdns"
                        }
                    }
                }
            ]
        },
        "speakers": {
            "patterns": [
                {
                    "name": "entity.name.tag.speaker.narrator.sdns",
                    "match": "^\\s*(NARRATOR)\\b",
                    "captures": {
                        "1": {
                            "name": "entity.name.tag.speaker.narrator.sdns"
                        }
                    }
                },
                {
                    "name": "entity.name.tag.speaker.sdns",
                    "match": "^\\s*(PATIENT|THERAPIST|SYSTEM)\\b",
                    "captures": {
                        "1": {
                            "name": "entity.name.tag.speaker.sdns"
                        }
                    }
                },
                {
                    "name": "entity.other.attribute-name.mood.sdns",
                    "match": "\\(([\\w\\s]+)\\)",
                    "captures": {
                        "1": {
                            "name": "entity.other.attribute-name.mood.sdns"
                        }
                    }
                }
            ]
        },
        "directives": {
            "patterns": [
                {
                    "name": "keyword.control.directive.sdns",
                    "match": "@(if|elseif|else|endif|when|end)\\b"
                },
                {
                    "name": "keyword.other.directive.sdns",
                    "match": "@(reveal|rapport|focus|unlock|set|pause|trigger)\\b"
                },
                {
                    "name": "constant.numeric.sdns",
                    "match": "@(rapport|focus|pause)\\s+([+-]?\\d+\\.?\\d*)",
                    "captures": {
                        "1": {
                            "name": "keyword.other.directive.sdns"
                        },
                        "2": {
                            "name": "constant.numeric.sdns"
                        }
                    }
                }
            ]
        },
        "goto": {
            "patterns": [
                {
                    "name": "keyword.control.goto.sdns",
                    "match": "->\\s*([@\\w\\.:/-]+)",
                    "captures": {
                        "1": {
                            "name": "entity.name.label.sdns"
                        }
                    }
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.sdns",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "include": "#keywords"
                        },
                        {
                            "include": "#keyword-metadata"
                        },
                        {
                            "include": "#markdown"
                        },
                        {
                            "include": "#observations"
                        },
                        {
                            "name": "constant.character.escape.sdns",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "actions": {
            "patterns": [
                {
                    "name": "string.other.action.sdns",
                    "begin": "\\*",
                    "end": "\\*",
                    "patterns": [
                        {
                            "include": "#keywords"
                        },
                        {
                            "include": "#observations"
                        }
                    ]
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "markup.bold.keyword.sdns",
                    "begin": "\\[",
                    "end": "\\]",
                    "patterns": [
                        {
                            "include": "#keyword-metadata"
                        }
                    ],
                    "captures": {
                        "0": {
                            "name": "markup.bold.keyword.text.sdns"
                        }
                    }
                }
            ]
        },
        "observations": {
            "patterns": [
                {
                    "comment": "Observation markers %text% styled like keywords (bold/blue)",
                    "name": "markup.bold.observation.sdns",
                    "begin": "(%)",
                    "end": "(%)",
                    "beginCaptures": {
                        "1": {
                            "name": "punctuation.definition.observation.begin.sdns"
                        }
                    },
                    "endCaptures": {
                        "1": {
                            "name": "punctuation.definition.observation.end.sdns"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#keyword-metadata"
                        }
                    ]
                }
            ]
        },
        "keyword-metadata": {
            "patterns": [
                {
                    "comment": "Universal type:source.category.id syntax - keyword, anim, symptom, observation, etc.",
                    "name": "entity.other.attribute-name.typed-reference.sdns",
                    "match": "(<)(keyword|anim|symptom|observation|action|effect):([a-zA-Z][a-zA-Z0-9_-]*)\\.([a-zA-Z][a-zA-Z0-9_-]*)\\.([a-zA-Z][a-zA-Z0-9_-]*)(>)",
                    "captures": {
                        "1": {
                            "name": "punctuation.definition.tag.begin.sdns constant.character.escape.sdns"
                        },
                        "2": {
                            "name": "storage.type.reference.sdns"
                        },
                        "3": {
                            "name": "entity.name.type.source.sdns"
                        },
                        "4": {
                            "name": "entity.name.type.category.sdns"
                        },
                        "5": {
                            "name": "variable.other.reference-id.sdns"
                        },
                        "6": {
                            "name": "punctuation.definition.tag.end.sdns constant.character.escape.sdns"
                        }
                    }
                },
                {
                    "comment": "Shorthand keyword syntax: <keyword:source.category.id>",
                    "name": "entity.other.attribute-name.keyword-link.sdns",
                    "match": "(<)keyword:([a-z]+)\\.([a-z]+)\\.([a-zA-Z_-]+)(>)",
                    "captures": {
                        "1": {
                            "name": "punctuation.definition.tag.begin.sdns constant.character.escape.sdns"
                        },
                        "2": {
                            "name": "entity.name.type.source.sdns"
                        },
                        "3": {
                            "name": "entity.name.type.category.sdns"
                        },
                        "4": {
                            "name": "variable.other.keyword-id.sdns"
                        },
                        "5": {
                            "name": "punctuation.definition.tag.end.sdns constant.character.escape.sdns"
                        }
                    }
                },
                {
                    "comment": "Animation syntax: <anim:animId> or <anim:shake>",
                    "name": "entity.other.attribute-name.animation.sdns",
                    "match": "(<)anim:([a-zA-Z][a-zA-Z0-9_-]*)(>)",
                    "captures": {
                        "1": {
                            "name": "punctuation.definition.tag.begin.sdns constant.character.escape.sdns"
                        },
                        "2": {
                            "name": "support.function.animation.sdns"
                        },
                        "3": {
                            "name": "punctuation.definition.tag.end.sdns constant.character.escape.sdns"
                        }
                    }
                },
                {
                    "comment": "Symptom reference syntax: <symptom:id>",
                    "name": "entity.other.attribute-name.symptom.sdns",
                    "match": "(<)symptom:([a-zA-Z][a-zA-Z0-9_-]*)(>)",
                    "captures": {
                        "1": {
                            "name": "punctuation.definition.tag.begin.sdns constant.character.escape.sdns"
                        },
                        "2": {
                            "name": "constant.other.symptom-id.sdns"
                        },
                        "3": {
                            "name": "punctuation.definition.tag.end.sdns constant.character.escape.sdns"
                        }
                    }
                },
                {
                    "comment": "Observation reference syntax: <observation:id>",
                    "name": "entity.other.attribute-name.observation.sdns",
                    "match": "(<)observation:([a-zA-Z][a-zA-Z0-9_-]*)(>)",
                    "captures": {
                        "1": {
                            "name": "punctuation.definition.tag.begin.sdns constant.character.escape.sdns"
                        },
                        "2": {
                            "name": "constant.other.observation-id.sdns"
                        },
                        "3": {
                            "name": "punctuation.definition.tag.end.sdns constant.character.escape.sdns"
                        }
                    }
                },
                {
                    "comment": "Legacy metadata syntax: <type:value>",
                    "name": "entity.other.attribute-name.metadata.sdns",
                    "begin": "(<)",
                    "end": "(>)",
                    "beginCaptures": {
                        "1": {
                            "name": "punctuation.definition.tag.begin.sdns constant.character.escape.sdns"
                        }
                    },
                    "endCaptures": {
                        "1": {
                            "name": "punctuation.definition.tag.end.sdns constant.character.escape.sdns"
                        }
                    },
                    "patterns": [
                        {
                            "name": "entity.other.attribute-name.type.sdns",
                            "match": "[\\w-]+(?=\\s*:)"
                        },
                        {
                            "name": "punctuation.separator.key-value.sdns",
                            "match": ":"
                        },
                        {
                            "name": "string.unquoted.id.sdns",
                            "match": "(?<=:)\\s*[^;>]+"
                        },
                        {
                            "name": "punctuation.separator.sequence.sdns",
                            "match": ";"
                        }
                    ]
                }
            ]
        },
        "markdown": {
            "patterns": [
                {
                    "comment": "Bold text **text**",
                    "name": "markup.bold.sdns",
                    "match": "\\*\\*([^*]+)\\*\\*",
                    "captures": {
                        "1": {
                            "name": "markup.bold.content.sdns"
                        }
                    }
                },
                {
                    "comment": "Italic text *text* or _text_",
                    "name": "markup.italic.sdns",
                    "match": "(?<!\\*)\\*([^*]+)\\*(?!\\*)|_([^_]+)_",
                    "captures": {
                        "1": {
                            "name": "markup.italic.content.sdns"
                        },
                        "2": {
                            "name": "markup.italic.content.sdns"
                        }
                    }
                },
                {
                    "comment": "Strikethrough text ~~text~~",
                    "name": "markup.strikethrough.sdns",
                    "match": "~~([^~]+)~~",
                    "captures": {
                        "1": {
                            "name": "markup.strikethrough.content.sdns"
                        }
                    }
                }
            ]
        },
        "conditions": {
            "patterns": [
                {
                    "name": "keyword.operator.comparison.sdns",
                    "match": "(>=|<=|==|!=|>|<)"
                },
                {
                    "name": "keyword.operator.logical.sdns",
                    "match": "(&&|\\|\\||!)"
                },
                {
                    "name": "support.function.sdns",
                    "match": "\\b(has_symptom|has_keyword|has_breakthrough|asked_about)\\b"
                },
                {
                    "name": "variable.other.sdns",
                    "match": "\\b(rapport|focus|turn|breakthroughs)\\b"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.sdns",
                    "match": "[+-]?\\b\\d+\\.?\\d*\\b"
                }
            ]
        }
    }
}